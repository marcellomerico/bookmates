# Copy to .env and fill in (never commit .env).
# Supabase: Dashboard → Project Settings → API (project URL and anon/publishable key)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Sign-In: Google Cloud Console → OAuth 2.0 Client IDs (optional)
# Web client ID, used by Supabase on iOS and Android
GOOGLE_WEB_CLIENT_ID=
# iOS client ID, improves the native Google flow on iOS
GOOGLE_IOS_CLIENT_ID=
